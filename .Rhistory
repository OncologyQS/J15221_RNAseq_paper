perPatNat = read.csv(paste0(rootDir,"for_paper/J15221_trial_paper/input_tables/table_24patient_info.csv"))
# check what patient is missing RNAseq data
print("patient without RNAseq data")
setdiff(perPatNat %>% filter(!is.na(RECIST)) %>% select(ID) %>% unlist(), perPat$pubID)
tab = table(perPat$assignment, perPat$RECIST)
print(tab)
chisq.test(tab)
tab = table(perPat$assignment, perPat$Subtype)
print(tab)
chisq.test(tab)
# samples removed from the TNBCtype analysis, because they were identified as ER+
