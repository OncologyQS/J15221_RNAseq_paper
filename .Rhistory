library(GSVA)
set.seed(1234)
rootDir = "C:/Users/ldanilo1/OneDrive - Johns Hopkins/J15221_Evanthia_breast_data/"
#rootDir = "../../"
source(paste0(rootDir,"Doc/2024-11-04_RNAseq_paper/J15221_RNAseq_paper/params_and_functions.r"))
# overwrite time colors
timeCol = setNames(c("black", 'grey45', 'grey75'), c("Baseline","C1D1","Week_8"))
tnbcCol = c("BL1" = "yellow", "BL2" = "olivedrab3", "IM" = "burlywood4", "MSL" = "orange", "LAR" = "purple", "UNS" = "white", "NA" = "grey")
# colors for gene set heatmaps to differ from gene expression heatmaps
heatmapCol = colorRampPalette(rev(brewer.pal(n = 7, name =
"RdYlBu")))(100)
# p-value threshold
pThresh = 0.1
sessionInfo()
# load deidentified expression and the corresponding annotation object
load(file = paste0(rootDir,'Analysis/Data/RNAseq/j15221_rnaseq_annot_deidentified.rda'))
dim(exprsDat)  #[1] 22955    37
# output table
datatable(sampAnnot)
# select baseline samples
baselineSamp = sampAnnot %>% filter(Timepoint == "Baseline") %>% rownames()
##Get VST for the whole dataset (including lymph nodes) for plotting
dds_plotting <- DESeqDataSetFromMatrix(countData = round(exprsDat[,rownames(sampAnnot)]),
colData = sampAnnot,
design=~Subtype)
vstDat_plotting <- assay(vst(dds_plotting))
vstDat_plotting <- vstDat_plotting[apply(vstDat_plotting,1,sd)>0,]
# save vst values for subtype analysis in csv format
#write.csv(vstDat_plotting, paste0(rootDir,"Analysis/Data/RNAseq/vstDat_plotting.csv"))
# and transposed for PUREE
# renames to use publication time points (C1D1)
#dat = t(vstDat_plotting)
#rownames(dat) = paste(sampAnnot[rownames(dat),"pubID"], sampAnnot[rownames(dat),"Timepoint"], sep = "_")
#write.csv(dat, paste0(rootDir,"Analysis/Data/RNAseq/vstDat_plotting_transposed.csv"))
#=================================
# save data for TNBCtype and ESTIMATE analyses
#=================================
#write.table(cbind(name = rownames(exprsDat), description = rownames(exprsDat), exprsDat), file = paste0(rootDir,'Analysis/Data/RNAseq/j15221_evanthia_breast_rnaseq_deidentified.gct'), sep = '\t', row.names = F)
# save TNBC samples only for the Vanderbilt classifier
# tnbcData = exprsDat[,sampAnnot %>% filter(Subtype == "TNBC") %>% rownames()]
#
# write.table(cbind(gene = rownames(tnbcData),tnbcData), file = paste0(rootDir,'Analysis/Data/RNAseq/j15221_evanthia_breast_rnaseq_deidentified_tnbc.tsv'), sep = '\t', row.names = F)
#
#
# save vst-normalized data
#write.table(round(vstDat_plotting, 3), paste0(rootDir,"Analysis/Data/RNAseq/vstDat_plotting.tsv"))
# in GCT format for ESTIMATE
#write.table(cbind(name = rownames(vstDat_plotting), description = rownames(vstDat_plotting), vstDat_plotting), file = paste0(rootDir,'Analysis/Data/RNAseq/vstDat_plotting.gct'), sep = '\t', row.names = F)
# save vst-normalized data for samples that TNBCtype identified as TNBC
# tnbcSamp  = rownames(sampAnnot)
# # read in samples, that TBNCtype identified as ER+
# erSamp = read.csv(paste0(rootDir,"Analysis/Data/RNAseq/TNBCtype/samples_remove_from_analysis.csv"), stringsAsFactors = F, header = F)
# erSamp = fix_sample_names(erSamp)
# # remove samples that TNBCtype identified as ER+
# tnbcSamp = tnbcSamp[!tnbcSamp %in% erSamp]
# write.csv(vstDat_plotting[,tnbcSamp], paste0(rootDir,"Analysis/Data/RNAseq/vstDat_plotting_tnbc.csv"))
# find patients with paired samples
mat = printPairs(sampAnnot, timepoint = "Timepoint", patID = "Patient_ID")
pairedPat <- mat %>% filter(Baseline == 1 & C1D1 == 1) %>% rownames()
# select paired samples and exclude a time point from comparison
annot <- sampAnnot %>% filter(Patient_ID %in% pairedPat & Timepoint != "Week_8")
##read in results
res = read.csv(paste0(rootDir,"Analysis/Data/RNAseq/2024-01-22_LN/BaselinevC1D1_DEGenes.csv"), row.names = 1)
# output all DE results
#datatable(data.frame(res))
# plots volcano plot and saves top DE genes
topDE_b_vs_c1 = plotVolcano(res, fdrThr = 0.05, logFCthr = 0.5,
fileName = NULL,
main_title = "Baseline vs C1D1", n = 13)
# topDE_b_vs_c1 = plotVolcano(res, fdrThr = 0.05, logFCthr = 0.5,
#                        fileName = NULL,
#                        main_title = "Baseline vs C1D1", n = 13,
#                        legendPosition = "right")
ht = plotHA(annot, vstDat_plotting, topDE_b_vs_c1,
title = "Baseline vs C1D1",
column_labels = annot$pubID, show_row_names = F,
heatmap_legend_param = list(direction = "horizontal"))
# find patients with paired samples
pairedPat <- mat %>% filter(Week_8 == 1 & C1D1 == 1) %>% rownames()
# select paired samples and exclude a time point from comparison
annot <- sampAnnot %>% filter(Patient_ID %in% pairedPat & Timepoint != "Baseline")
#datatable(annot)
##DE by Time
res = read.csv(paste0(rootDir,"Analysis/Data/RNAseq/2024-01-22_LN/Week_8_vs_C1D1_DEGenes.csv"), row.names = 1)
# output all DE results
#datatable(data.frame(res))
# plots volcano plot and saves top DE genes
topDE_c_vs_w8 = plotVolcano(res, fdrThr = 0.05, logFCthr = 0.5,
fileName = NULL,
main_title = "C1D1 vs Week 8", n = 15)
plotHA(annot, vstDat_plotting, topDE_c_vs_w8, title = "C1D1 vs Week 8",
column_labels = annot$pubID, show_row_names = F,
heatmap_legend_param = list(direction = "horizontal"))
# find patients with paired samples
pairedPat <- mat %>% filter(Week_8 == 1 & Baseline == 1) %>% rownames()
# select paired samples and exclude a time point from comparison
annot <- sampAnnot %>% filter(Patient_ID %in% pairedPat & Timepoint != "C1D1")
#datatable(annot)
res = read.csv( paste0(rootDir,"Analysis/Data/RNAseq/2024-01-22_LN/Week_8_vs_Baseline_DEGenes.csv"), row.names = 1)
# output all DE results
#datatable(data.frame(res))
# plots volcano plot and saves top DE genes
topDE_b_vs_w8 = plotVolcano(res, fdrThr = 0.05, logFCthr = 0.5,
fileName = NULL,
main_title = "Baseline vs Week 8")
plotHA(annot, vstDat_plotting, topDE_b_vs_w8, title = "Baseline vs Week 8",
column_labels = annot$pubID, show_row_names = F,
heatmap_legend_param = list(direction = "horizontal"))
# load pathways from paired analysis
c1d1_week8_h = read.csv(paste0(rootDir,"Analysis/Data/RNAseq/2024-01-22_LN/C1D1vWeek8_Hallmark.csv"))
c1d1_week8_h_sig = c1d1_week8_h %>% filter(padj < 0.05)
b_week8_h = read.csv(paste0(rootDir,"Analysis/Data/RNAseq/2024-01-22_LN/BvWeek8_Hallmark.csv"))
b_week8_h_sig = b_week8_h %>% filter(padj < 0.05)
# merge pathwyay analysis results for plotting
pathRes = rbind(cbind(comparison = rep("Baseline_vs_Week8",nrow(b_week8_h)),b_week8_h),
cbind(comparison = rep("C1D1_vs_Week8",nrow(c1d1_week8_h)),c1d1_week8_h))
# make NES for not significant pathways as NA
pathRes_ns = pathRes %>% mutate(NES, NES = ifelse(padj >0.05, NA, NES))
# remove "HALLMARK_" from all pathways
pathRes_ns$pathway = gsub("HALLMARK_","",pathRes_ns$pathway)
# plot: dot plot
p = ggplot(data = pathRes_ns %>% filter(!is.na(NES)), aes(x = comparison, y = pathway, color = NES)) +
geom_point(size = 4) +
#  scale_color_gradient(low = "red", high = "blue") +
scale_colour_gradient2(low = "blue", high = "red") +
scale_x_discrete(labels = c("Baseline vs Week 8","After run-in vs Week 8")) +
theme(axis.text.x = element_text(angle = 90, vjust = 0.5))+
ggtitle("Halmark pathways")
print(p)
# find common significant pathways
comm_path = intersect(c1d1_week8_h_sig$pathway, b_week8_h_sig$pathway)
print("Common significant pathways:")
print(comm_path)
# find common significant genes
comm_genes = intersect(topDE_b_vs_w8, topDE_c_vs_w8)
print("Common significant genes:")
print(comm_genes)
# intersect genes in the pathways and significant genes
HALLMARK_df = msigdbr(species = "Homo sapiens", category = "H")
HALLMARK_list = HALLMARK_df %>% split(x = .$gene_symbol, f = .$gs_name)
for( i in comm_path){
print(i)
print(intersect(HALLMARK_list[[i]], comm_genes))
}
##Subset samples to be included
annot <- sampAnnot[sampAnnot$Timepoint=="Baseline",]
table(annot$RECIST)
res = read.csv(paste0(rootDir,"Analysis/Data/RNAseq/2024-01-22_LN/Baseline_RespondervNonResponder_DEGenes.csv"), row.names = 1)
# output all DE results
#datatable(data.frame(res))
# plots volcano plot and saves top DE genes
topDE_b = plotVolcano(res, fdrThr = 0.05, logFCthr = 0.5,
fileName = NULL,
main_title = "Baseline. NonResponder vs Responder")
head(topDE_b)
res[head(topDE_b),]
# create a table with top 10 or less up- and down-regulated genes for every comparison
top10Genes = matrix(NA, nrow = 10, ncol = 6)
colnames(top10Genes) = c("Baseline_up","Baseline_down","C1D1_up","C1D1_down",
"Week8_up","Week8_down")
top10Genes
# add top gene from this comparison
sig = res[topDE_b,"log2FoldChange"] >0
top10Genes[,"Baseline_up"] = topDE_b[sig][1:10]
top10Genes[,"Baseline_down"] = topDE_b[!sig][1:10]
