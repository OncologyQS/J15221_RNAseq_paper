##use all samples including lymph nodes
plotHA(annot, vstDat_plotting, topDE_b, title = "Baseline",
column_labels = annot$pubID, show_row_names = F,
heatmap_legend_param = list(direction = "horizontal"))
#Gather Genes from msigdbr
HALLMARK_df = msigdbr(species = "Homo sapiens", category = "H")
HALLMARK_list = HALLMARK_df %>% split(x = .$gene_symbol, f = .$gs_name)
# ssGSA on hallmark
gsvapar_h <- gsvaParam(dds_plotting, HALLMARK_list)
gsva_scores_h <- gsva(gsvapar_h)
# load pathways from paired analysis
b_h = read.csv(paste0(rootDir,"Analysis/Data/RNAseq/2024-01-22_LN/Baseline_RespondervNonResponder_Hallmark.csv"))
b_h_sig = b_h %>% filter(padj < 0.05)
# remove "HALLMARK_" from all pathway names to be used as row names
p = gsub("HALLMARK_","",b_h_sig$pathway)
annot =sampAnnot %>% filter(Timepoint == "Baseline")
plotHA(annot, assay(gsva_scores_h)[b_h_sig$pathway,], scale = F,
title = "Hallmark pathways. Baseline. GSVA scores", col = heatmapCol,column_labels = annot$pubID,
row_labels = p)
##Subset samples to be included
annot <- sampAnnot[sampAnnot$Timepoint=="C1D1",]
table(annot$RECIST)
