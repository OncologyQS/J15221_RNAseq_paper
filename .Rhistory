erSamp = fix_sample_names(erSamp)
print("Samples removed from the TNBCtype analysis:")
print(erSamp)
# add TNBCtype assignments to the sample annotation
# read in TNBCtype assignments
tnbc_assign = read.csv(paste0(rootDir,'Analysis/Data/RNAseq/TNBCtype/vst_input_all_samples/5ccca5bc-a76e-4320-9c01-49817ade4087_result.csv'), header = T, row.names = 1)
# coefficients
tnbc_coef = read.csv(paste0(rootDir,'Analysis/Data/RNAseq/TNBCtype/vst_input_all_samples/5ccca5bc-a76e-4320-9c01-49817ade4087_coef.csv'), header = T, row.names = 1)
# add this assignment to the patient annotation
# but first we need to fix samples names in tnbc_assign
rownames(tnbc_assign) = fix_sample_names(rownames(tnbc_assign))
rownames(tnbc_coef) = fix_sample_names(rownames(tnbc_coef))
datatable(tnbc_assign, options = list(pageLength = 13))
datatable(round(tnbc_coef,3), options = list(pageLength = 13))
# check if all samples are present in the tnbc_assign
dim(tnbc_assign)
# add to sample and per patient annotation
sampAnnot_pam50$TNBCtype = "NA"
s = intersect(rownames(tnbc_assign), rownames(sampAnnot_pam50))
sampAnnot_pam50[s,"TNBCtype"] = tnbc_assign[s,"subtype"]
s = intersect(rownames(tnbc_assign), rownames(perPat))
perPat$TNBCtype = "NA"
perPat[s,"TNBCtype"] = tnbc_assign[s,"subtype"]
# order by patient first
ord = rownames(perPat)[order(perPat$Subtype,perPat$RECIST,perPat$Best_Resp, perPat$Tissue_Broad)]
perPat = perPat[ord,]
ht_pat = plotHA_pam50_tnbc(perPat, vstDat_plotting, genes[1:2], title = "Annotations. Per patient",
column_labels = perPat$pubID, show_row_names = T,
cluster_columns = F)
ord = rownames(sampAnnot_pam50)[order(sampAnnot_pam50$Subtype,sampAnnot_pam50$RECIST,sampAnnot_pam50$Best_Resp, sampAnnot_pam50$Tissue_Broad, sampAnnot_pam50$pubID, sampAnnot_pam50$Timepoint)]
sampAnnot_pam50 = sampAnnot_pam50[ord,]
ht = plotHA_pam50_tnbc(sampAnnot_pam50, vstDat_plotting, genes[1:2], title = "All samples",
column_labels = sampAnnot_pam50$pubID, show_row_names = T,
cluster_columns = F)
# read in scores
scores = read.xlsx(paste0(rootDir,"Doc/2024-11-04_RNAseq_paper/Supplementary_tables_15-19_TME.xlsx"), sheetIndex = 2, startRow = 2, colNames = T, check.names = F)
rownames(scores) = scores[,1]
scores = scores[,-1]
colnames(scores) = gsub("Post Run-in","C1D1",colnames(scores))
# read in p-values
res = read.xlsx(paste0(rootDir,"Doc/2024-11-04_RNAseq_paper/Supplementary_tables_15-19_TME.xlsx"), sheetIndex = 3, startRow = 2, colNames = T, check.names = F)
rownames(res) = res[,1]
res = res[,-1]
sig_t1 = rownames(res)[which(res[,"pValue_T1_RvsNR"] < pThresh)]
# order by patient and time
ord_all = rownames(sampAnnot)[order(sampAnnot$RECIST,sampAnnot$Best_Resp, sampAnnot$Subtype, sampAnnot$pubID,sampAnnot$Timepoint)]
# C1D1 only
ord = grep("C1D1",ord_all, value = T)
# heatmap
plotHA(sampAnnot[ord,],scores[sig_t1,ord], scale = F, title = "TME gene sets. C1D1", col = heatmapCol, column_order = ord, column_labels  = gsub("_C1D1","",ord))
# get significant by time point
sig_t2 = rownames(res)[which(res[,"pValue_T2_RvsNR"] < pThresh)]
# Week 8 only
ord = grep("Week 8",ord_all, value = T)
plotHA(sampAnnot[ord,],scores[sig_t2,ord], scale = F, title = "TME gene sets. Week 8", col = heatmapCol, column_order = ord,
column_labels  = gsub("_Week 8","",ord) )
