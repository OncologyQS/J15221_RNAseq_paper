fileName = NULL,
main_title = "Week 8. NonResponder vs Responder", n = 25)
# add top gene from this comparison
sig = res[topDE_w8,"log2FoldChange"] >0
top10Genes[,"C1D1_up"] = topDE_w8[sig][1:10]
top10Genes[,"C1D1_down"] = topDE_w8[!sig][1:10]
