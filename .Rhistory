plotHA(anno, vstDat_plotting, topDE_w8, title = "Week 8",
column_labels = annot$pubID, show_row_names = F,
heatmap_legend_param = list(direction = "horizontal"))
# add PAM50 assignments to the sample annotation
# read in pam50 assignments
pam50_assign = read.table(paste0(rootDir,'Analysis/Data/RNAseq/PAM50/with_normals/pam50_assignments.tsv'), sep = '\t', header = T, row.names = 1)
sampAnnot_pam50 = merge(sampAnnot, pam50_assign, by = "row.names", all.x = T)
rownames(sampAnnot_pam50) = sampAnnot_pam50$Row.names
# get pam50 genes
genes = pam50::pam50_annot$gene_name
ht = plotHA_pam50(sampAnnot_pam50, vstDat_plotting, genes, title = "PAM50 genes",
column_labels = sampAnnot_pam50$pubID, show_row_names = T)
perPat = sampAnnot_pam50[!duplicated(sampAnnot_pam50$Patient_ID),]
ht_pat = plotHA_pam50(perPat, vstDat_plotting, genes, title = "PAM50 genes. Per patient",
column_labels = perPat$pubID, show_row_names = T)
# check what patient is missing RNAseq data
# load per patient table from the Nature Cancer paper
perPatNat = read.csv(paste0(rootDir,"for_paper/J15221_trial_paper/input_tables/table_24patient_info.csv"))
# check what patient is missing RNAseq data
print("patient without RNAseq data")
setdiff(perPatNat %>% filter(!is.na(RECIST)) %>% select(ID) %>% unlist(), perPat$pubID)
tab = table(perPat$assignment, perPat$RECIST)
print(tab)
chisq.test(tab)
tab = table(perPat$assignment, perPat$Subtype)
print(tab)
chisq.test(tab)
# samples removed from the TNBCtype analysis, because they were identified as ER+
erSamp = read.csv(paste0(rootDir,"Analysis/Data/RNAseq/TNBCtype/samples_remove_from_analysis.csv"), stringsAsFactors = F, header = F)
erSamp = fix_sample_names(erSamp)
print("Samples removed from the TNBCtype analysis:")
print(erSamp)
# add TNBCtype assignments to the sample annotation
# read in TNBCtype assignments
tnbc_assign = read.csv(paste0(rootDir,'Analysis/Data/RNAseq/TNBCtype/vst_input_all_samples/5ccca5bc-a76e-4320-9c01-49817ade4087_result.csv'), header = T, row.names = 1)
# coefficients
tnbc_coef = read.csv(paste0(rootDir,'Analysis/Data/RNAseq/TNBCtype/vst_input_all_samples/5ccca5bc-a76e-4320-9c01-49817ade4087_coef.csv'), header = T, row.names = 1)
# add this assignment to the patient annotation
# but first we need to fix samples names in tnbc_assign
rownames(tnbc_assign) = fix_sample_names(rownames(tnbc_assign))
rownames(tnbc_coef) = fix_sample_names(rownames(tnbc_coef))
datatable(tnbc_assign, options = list(pageLength = 13))
datatable(round(tnbc_coef,3), options = list(pageLength = 13))
# check if all samples are present in the tnbc_assign
dim(tnbc_assign)
# add to sample and per patient annotation
sampAnnot_pam50$TNBCtype = "NA"
s = intersect(rownames(tnbc_assign), rownames(sampAnnot_pam50))
sampAnnot_pam50[s,"TNBCtype"] = tnbc_assign[s,"subtype"]
s = intersect(rownames(tnbc_assign), rownames(perPat))
perPat$TNBCtype = "NA"
perPat[s,"TNBCtype"] = tnbc_assign[s,"subtype"]
# order by patient first
ord = rownames(perPat)[order(perPat$Subtype,perPat$RECIST,perPat$Best_Resp, perPat$Tissue_Broad)]
perPat = perPat[ord,]
ht_pat = plotHA_pam50_tnbc(perPat, vstDat_plotting, genes[1:2], title = "Annotations. Per patient",
column_labels = perPat$pubID, show_row_names = T,
cluster_columns = F)
ord = rownames(sampAnnot_pam50)[order(sampAnnot_pam50$Subtype,sampAnnot_pam50$RECIST,sampAnnot_pam50$Best_Resp, sampAnnot_pam50$Tissue_Broad, sampAnnot_pam50$pubID, sampAnnot_pam50$Timepoint)]
sampAnnot_pam50 = sampAnnot_pam50[ord,]
ht = plotHA_pam50_tnbc(sampAnnot_pam50, vstDat_plotting, genes[1:2], title = "All samples",
column_labels = sampAnnot_pam50$pubID, show_row_names = T,
cluster_columns = F)
# read in scores
scores = read.xlsx(paste0(rootDir,"Doc/2024-11-04_RNAseq_paper/Supplementary_tables_TME.xlsx"), sheetIndex = 2, startRow = 2, colNames = T, check.names = F)
rownames(scores) = scores[,1]
scores = scores[,-1]
# read in p-values
res = read.xlsx(paste0(rootDir,"Doc/2024-11-04_RNAseq_paper/Supplementary_tables_TME.xlsx"), sheetIndex = 3, startRow = 2, colNames = T, check.names = F)
rownames(res) = res[,1]
res = res[,-1]
sig_t1 = rownames(res)[which(res[,"pValue_T1_RvsNR"] < pThresh)]
# order by patient and time
ord_all = rownames(sampAnnot)[order(sampAnnot$RECIST,sampAnnot$Best_Resp, sampAnnot$Subtype, sampAnnot$pubID,sampAnnot$Timepoint)]
# C1D1 only
ord = grep("Post Run-in",ord_all, value = T)
# heatmap
plotHA(sampAnnot[ord,],scores[sig_t1,ord], scale = F, title = "TME gene sets. C1D1", col = heatmapCol, column_order = ord, column_labels  = gsub("_Post Run-in","",ord))
# get significant by time point
sig_t2 = rownames(res)[which(res[,"pValue_T2_RvsNR"] < pThresh)]
# Week 8 only
ord = grep("Week 8",ord_all, value = T)
plotHA(sampAnnot[ord,],scores[sig_t2,ord], scale = F, title = "TME gene sets. Week 8", col = heatmapCol, column_order = ord,
column_labels  = gsub("_Week 8","",ord) )
datatable(top10Genes)
res = read.csv(paste0(rootDir,"Analysis/Data/RNAseq/2024-01-22_LN/Week8_RespondervNonResponder_DEGenes.csv"), row.names = 1)
# output all DE results
#datatable(data.frame(res))
# plots volcano plot and saves top DE genes
topDE_w8 = plotVolcano(res, fdrThr = 0.05, logFCthr = 0.5,
fileName = NULL,
main_title = "Week 8. NonResponder vs Responder", n = 25)
# add top gene from this comparison
sig = res[topDE_w8,"log2FoldChange"] >0
top10Genes[,"C1D1_up"] = topDE_w8[sig][1:10]
top10Genes[,"C1D1_down"] = topDE_w8[!sig][1:10]
sig = res[topDE_w8,"log2FoldChange"] >0
top10Genes[,"Week8_up"] = topDE_w8[sig][1:10]
top10Genes[,"Week8_down"] = topDE_w8[!sig][1:10]
datatable(top10Genes)
write.csv(top10Genes,"top10Genes.csv")
/10
/10
7/10
4/5
