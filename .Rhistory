##Subset samples to be included
annot <- sampAnnot[sampAnnot$Timepoint=="Week_8",]
table(annot$RECIST)
res = read.csv(paste0(inputFolder,"DE_RECIST/Week8_RespondervNonResponder_DEGenes.csv"), row.names = 1)
# output all DE results
#datatable(data.frame(res))
# plots volcano plot and saves top DE genes
topDE_w8 = plotVolcano(res, fdrThr = 0.05, logFCthr = 0.5,
fileName = NULL,
main_title = "Week 8. Non-responder vs Responder", n = 25)
# add top gene from this comparison
sig = res[topDE_w8,"log2FoldChange"] >0
top10Genes[,"Week8_up"] = topDE_w8[sig][1:10]
top10Genes[,"Week8_down"] = topDE_w8[!sig][1:10]
##read in data for heatmap
dat = read.csv(paste0(inputFolder,"DE_RECIST/Week8_R_vs_NR_DEGenes_heatmap.csv"), row.names = 1, check.names = F)
annot <- sampAnnot[sampAnnot$Timepoint=="Week_8",]
plotHA(annot, dat, rownames(dat), title = "Week 8",scale = F,
column_labels = annot$pubID, show_row_names = F,
heatmap_legend_param = list(direction = "horizontal"))
datatable(top10Genes)
write.csv(top10Genes,"top10Genes.csv", row.names = F)
